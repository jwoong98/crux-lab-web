// Cloudflare Worker crux-lab-cms for https://cms.pastcrux.com (PLAN DEV-051, DEC-010). The deploy copy is
// deploy/cms/wrangler.jsonc with the paths from the cms root (npm run sync:deploy, DEV-052).
// cms-worker/index.mjs runs first for /api/* only (POST /api/publish); every other address is the CMS build (dist-cms) with
// the SPA fallback and the headers of public-cms/_headers. The placeholders GUIDE_KV_ID, SUPABASE_URL and SUPABASE_ANON_KEY
// are public values sync-deploy takes from app/.env.local (CF_GUIDE_KV_ID, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY).
// GUIDE_KV is the namespace the public Worker crux-lab-web reads. The Worker uses no secret and no service_role key: it calls
// Supabase with the admin's own access token. PRIVACY_PUBLISHED "true" adds the privacy policy link to the rendered pages.
// workers_dev and preview_urls are off: Cloudflare Access protects cms.pastcrux.com only, so the Worker has no other address
// (cms 기획 2️⃣ 접속 보호, FINAL_REVIEW F-policy-2).
{
  "name": "crux-lab-cms",
  "main": "cms-worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist-cms",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "GUIDE_KV", "id": "e017a110906143e7a6d41c5a76cfabf2" }],
  "vars": {
    "SUPABASE_URL": "https://jbvvlommflfwaybpepyq.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_mSop_HNMCJKUw50iRkC1Ew_M6bSSxMk",
    "PRIVACY_PUBLISHED": "false"
  },
  "routes": [{ "pattern": "cms.pastcrux.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
